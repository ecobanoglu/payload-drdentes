# PostgreSQL bağlantısı (yerelde: docker compose up -d ile açılan veritabanı)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payload-drdentes

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# E-posta (Resend) — https://resend.com/api-keys ("Sending access" yeterli)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Resend'de doğrulanmış alan adından gönderici (doğrulanana kadar onboarding@resend.dev)
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Dr. Dentes
# Form bildirimlerinin varsayılan alıcısı
EMAIL_CONTACT_TO=info@example.com

# Cloudflare R2 medya depolaması — hepsi doluysa etkin, boşsa public/media kullanılır
# R2 → Manage API tokens → "Object Read & Write" (yalnızca bu bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drdentes-media
# Özel alan adı (önerilen) veya https://pub-xxxx.r2.dev — sonda "/" olmadan
R2_PUBLIC_URL=https://media.example.com
# Vercel'de büyük dosyalar için tarayıcıdan doğrudan yükleme (bucket CORS gerekir)
R2_CLIENT_UPLOADS=false
